rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: Only owners can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rate limits: Owners can read (for UI), but only Admin (Server) can write
    match /rate_limits/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // Conversations and messages
    match /conversations/{convId} {
      allow read, write, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }
    // Global AI Review Cache: Publicly readable, only Server writable
    match /ai_reviews_cache/{hash} {
      allow read: if true;
      allow write: if false; // Only Admin SDK can write
    }
  }
}
